# Build output. `make build` writes here; nothing under it is ever committed.
/bin/
/dist/
/tod-serve
/tod-serve.exe
coverage.out
coverage.html
*.test
*.prof

# Local databases. An officer's debugging tool is `sqlite3 tod.db`, so these appear in working
# trees constantly and must never reach a commit — a committed database is a committed credential.
*.db
*.db-wal
*.db-shm
/data/

# Web build output — produced in CI and embedded in the binary.
/web/dist/
/web/node_modules/
/web/.vite/
/web/node_modules/.tmp/
node_modules/
.pnpm-store/

# The go:embed target for internal/ui. `make build` copies web/dist here; that hashed output is
# build output. The committed placeholder is the exception that keeps internal/ui buildable with
# no JS toolchain present.
/internal/ui/dist/*
!/internal/ui/dist/.gitkeep

# The operator's `.env`. It holds TOD_TOKEN_PEPPER, TOD_SESSION_KEY and TOD_SETUP_TOKEN, and
# `deploy/env.example` — the file it is copied from — says "Never commit the real thing" with
# nothing behind it. This is that nothing, filled in: the same reasoning as `*.db` above and
# harder, because the pepper keys every credential hash the database holds.
#
# It is `deploy/.env` in practice, not `/.env`: docker compose resolves `.env` from the directory
# of the first `-f` file, so a `.env` at the repository root is read by nothing. Both are ignored
# because both get created by somebody following instructions.
#
# `deploy/env.example` is NOT matched — its basename has no leading dot — and the negation covers
# the dotted spelling, so the example this project ships stays committed either way.
.env
.env.*
!.env*.example

# Seed data. Timers load from the separate tod-serve-p99-seed repository and are deliberately not
# bundled (canonical conventions §15). A seed file in the tree is how that firewall gets breached
# by accident.
/seed/
*.seed.json

# Editor and OS noise.
.DS_Store
*.swp
.idea/
.vscode/

# Local runs of deploy/compose.yaml write snapshots here. The droplet keeps them in
# /opt/tod-serve/backups; this directory is only ever a developer artefact.
/deploy/backups/

# Scratch reproductions. They hold generated secrets and belong to nobody.
/.repro/
/.rehearsal/
