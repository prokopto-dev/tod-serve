{
  "components": {
    "schemas": {
      "Field": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Dotted path to the part of the request that was rejected",
            "type": "string"
          },
          "message": {
            "description": "What was wrong with it",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "description": "Ambiguous resolve candidates"
          },
          "capped_by": {
            "description": "What narrowed the request below what it asked for",
            "type": "string"
          },
          "current": {
            "description": "The resource as it is now, on a 412"
          },
          "request_id": {
            "description": "Correlates this response with the instance log",
            "type": "string"
          },
          "retry_after_seconds": {
            "description": "Seconds to wait before retrying",
            "format": "int64",
            "type": "integer"
          },
          "step_up_window_seconds": {
            "description": "Required re-authentication recency",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageTokenView": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TokenView"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "has_more",
          "as_of"
        ],
        "type": "object"
      },
      "PrincipalView": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "circle_id": {
            "description": "A ULID: 26 characters of Crockford base32, lexicographically time-ordered.",
            "examples": [
              "01K3TGT8N9M4X0Q7R2VB6C5D1E"
            ],
            "maxLength": 26,
            "minLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "membership_id": {
            "description": "A ULID: 26 characters of Crockford base32, lexicographically time-ordered.",
            "examples": [
              "01K3TGT8N9M4X0Q7R2VB6C5D1E"
            ],
            "maxLength": 26,
            "minLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "step_up_window_seconds": {
            "format": "int64",
            "type": "integer"
          },
          "stepped_up": {
            "type": "boolean"
          },
          "token_expires_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "token_prefix": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "membership_id",
          "circle_id",
          "role",
          "display_name",
          "permissions",
          "scopes",
          "token_prefix",
          "token_expires_at",
          "stepped_up",
          "step_up_window_seconds",
          "as_of"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable code from a closed enum",
            "enum": [
              "malformed_request",
              "unauthenticated",
              "token_invalid",
              "token_expired",
              "forbidden",
              "insufficient_scope",
              "session_required",
              "step_up_required",
              "not_found",
              "method_not_allowed",
              "not_acceptable",
              "request_timeout",
              "conflict",
              "precondition_failed",
              "payload_too_large",
              "unsupported_media_type",
              "validation_failed",
              "precondition_required",
              "idempotency_key_required",
              "idempotency_key_reused",
              "idempotency_conflict",
              "rate_limited",
              "internal_error",
              "service_unavailable",
              "membership_revoked",
              "invite_invalid",
              "invite_expired",
              "invite_exhausted",
              "invite_revoked",
              "provider_not_accepted",
              "provider_disabled",
              "provider_unverifiable",
              "credential_invalid",
              "credential_expired",
              "credential_stale",
              "identity_provider_unreachable",
              "acknowledgement_required",
              "server_mismatch",
              "died_at_in_future",
              "died_at_too_old",
              "report_immutable",
              "already_retracted",
              "retract_not_permitted",
              "unknown_target",
              "ambiguous_target",
              "last_owner",
              "field_immutable",
              "link_requires_verifiable_identity",
              "guild_membership_required",
              "guild_role_required",
              "auth_ticket_invalid",
              "auth_ticket_expired",
              "auth_flow_expired",
              "identity_blocked",
              "credential_audience_mismatch",
              "provider_scope_declined"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Explanation specific to this occurrence",
            "type": "string"
          },
          "errors": {
            "description": "Per-field detail, where the failure has any",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "The request this problem is about",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta",
            "description": "Structured extras this problem needs"
          },
          "status": {
            "description": "HTTP status code",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type, identical on every occurrence",
            "type": "string"
          },
          "type": {
            "description": "Documentation for this error code; the last segment is the code",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "ServerMeta": {
        "additionalProperties": false,
        "properties": {
          "api_versions": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "as_of": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "self_service_circle_creation": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "api_versions",
          "configured",
          "self_service_circle_creation",
          "as_of"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "created_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "A ULID: 26 characters of Crockford base32, lexicographically time-ordered.",
            "examples": [
              "01K3TGT8N9M4X0Q7R2VB6C5D1E"
            ],
            "maxLength": 26,
            "minLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "last_used_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "token_prefix": {
            "type": "string"
          }
        },
        "required": [
          "as_of",
          "id",
          "name",
          "token_prefix",
          "scopes",
          "created_at",
          "last_used_at",
          "expires_at",
          "revoked_at"
        ],
        "type": "object"
      },
      "TokenView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "A ULID: 26 characters of Crockford base32, lexicographically time-ordered.",
            "examples": [
              "01K3TGT8N9M4X0Q7R2VB6C5D1E"
            ],
            "maxLength": 26,
            "minLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "last_used_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "description": "RFC 3339 with microsecond precision, always UTC.",
            "examples": [
              "2026-08-18T02:14:07.000000Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "token_prefix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "token_prefix",
          "scopes",
          "created_at",
          "last_used_at",
          "expires_at",
          "revoked_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "metricsToken": {
        "description": "TOD_METRICS_TOKEN, on the separate metrics listener. Never a PAT scope.",
        "scheme": "bearer",
        "type": "http"
      },
      "patBearer": {
        "description": "A personal access token, `tods_pat_…`. Never in a query string.",
        "scheme": "bearer",
        "type": "http"
      },
      "sessionCookie": {
        "description": "A browser session. The only credential that reaches the capability floor.",
        "in": "cookie",
        "name": "__Host-tod_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "tod-serve",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentPrincipal",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrincipalView"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "patBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "The calling principal: membership, circle, role, effective permissions, token prefix, scopes, expiry",
        "x-tod-any-scope": true,
        "x-tod-circle-scoped": false,
        "x-tod-creates-state": false,
        "x-tod-etag": false,
        "x-tod-idempotency": "",
        "x-tod-if-match-required": false,
        "x-tod-permission": {
          "kind": "self",
          "requires_step_up": false
        },
        "x-tod-scopes": [],
        "x-tod-session-only": false
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getServerMeta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMeta"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {}
        ],
        "summary": "Version, API versions, feature flags, and whether self-service circle creation is on",
        "x-tod-any-scope": false,
        "x-tod-circle-scoped": false,
        "x-tod-creates-state": false,
        "x-tod-etag": false,
        "x-tod-idempotency": "",
        "x-tod-if-match-required": false,
        "x-tod-permission": {
          "kind": "public",
          "requires_step_up": false
        },
        "x-tod-scopes": [],
        "x-tod-session-only": false
      }
    },
    "/api/v1/tokens": {
      "get": {
        "operationId": "listMyTokens",
        "parameters": [
          {
            "description": "Opaque cursor from a previous page's next_cursor",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous page's next_cursor",
              "type": "string"
            }
          },
          {
            "description": "Page size, 1-200",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1-200",
              "format": "int64",
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageTokenView"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "patBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "My own devices. Officers see nobody's",
        "x-tod-any-scope": true,
        "x-tod-circle-scoped": false,
        "x-tod-creates-state": false,
        "x-tod-etag": false,
        "x-tod-idempotency": "",
        "x-tod-if-match-required": false,
        "x-tod-permission": {
          "kind": "self",
          "requires_step_up": false
        },
        "x-tod-scopes": [],
        "x-tod-session-only": false
      }
    },
    "/api/v1/tokens/{token_id}": {
      "delete": {
        "operationId": "revokeToken",
        "parameters": [
          {
            "description": "The token to revoke. Must be one of your own",
            "in": "path",
            "name": "token_id",
            "required": true,
            "schema": {
              "description": "The token to revoke. Must be one of your own",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Revoke one of my own devices",
        "x-tod-any-scope": false,
        "x-tod-circle-scoped": false,
        "x-tod-creates-state": false,
        "x-tod-etag": false,
        "x-tod-idempotency": "",
        "x-tod-if-match-required": false,
        "x-tod-permission": {
          "kind": "self",
          "requires_step_up": false
        },
        "x-tod-scopes": [],
        "x-tod-session-only": true
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
